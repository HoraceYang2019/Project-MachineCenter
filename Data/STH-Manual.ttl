sth:vtr_folder_structure a sth:section ;
    rdfs:label "VTR folder structure"@en ;
    sth:default_log_file_location "C:\\VTR\\Logs\\" ;
    sth:default_parsed_csv_location "C:\\VTR\\RawData\\Output\\*.csv" ;
    sth:default_raw_data_location "C:\\VTR\\RawData\\Source\\Data\\*.txt" ;
    sth:description "VTR folder structure. VTR: Virtual Tool Room. STH: Smart Tool Holder. Root directory C:\\VTR. Applications in C:\\VTR: InitSTH.py — initial parameter values for the DataProcess and STHLink executables; InitSTH_u.json — InitSTH.py parameters updated through the UI, such as Connection Check; STHScan.exe — scans and configures the STH network, such as LOAD STHSCAN; STHLink.exe — connects to the STH and establishes a connection; STHComm.exe — main program for connecting to the STH, such as LOAD ALL; DataProcess.exe — processes detected raw data from RawData\\Source\\Data\\*.txt into force data at RawData\\Output\\*.csv. Subfolders in C:\\VTR: .\\Library — libraries for specific functions; .\\Logs — error log files generated by Node-Red and STHLink; .\\Node-red — user flows and system configuration files; .\\Plans — production or experimental plans used by Node-Red (YAML or JSON); .\\RawData — raw data collected by STHLink and processed by DataProcess.exe; .\\Reports — YAML-plan-related data reports used by Node-Red; .\\Simulation — YAML-plan-related simulation CSV files used by HiNC. Files in the Library folder: MergeFile.exe — executable function for merging files in a folder. Files in the Logs folder: STHerror.txt — error log recorded by STHLink; msg_log (MM-dd mm-ss) — MQTT messages collected by Node-Red. Files in the NodeRed folder: setting.js — Node-Red configuration file; VTR-flows (yyyyMMv) — Node-Red flow nodes; .\\YYYYMMv — individual Node-Red flows; .\\Medium — Node-Red image files. Files in the Plans folder, such as created and updated plans: LL-FR-A-MC-ID-IP-YYMMDD-setup-.yml — production plan in YAML format; LL-FR-A-MC-ID-IP-YYMMDD-setup-.json — production plan in JSON format. Files in the RawData folder, such as Save Settings: .\\Source — source folder storing raw data (.txt) collected by STHLink; .\\Data; .\\(YYYY-MM-DD-hh-mm) *.txt — raw TXT files; .\\Output — output folder storing CSV files processed from Source/Data; .\\(YYYYMMDDhh) — folder recording time; *.csv — parsed CSV files; (YYYYMMDDhh)merged.csv — CSV file merged by folder; .\\Coefficient — folder storing calibration coefficients, such as coefficient settings; AvailableSTH.csv — available STH coefficient file. Files in the Reports folder. Files in the Simulation folder: .\\NCfile sim_part_YYYMMddV.csv — simulation data. Configuration files: Node-Red configuration, such as setting.js. In setting.js: flowFile: 'vtr_flows(YYYYMMDDV).json', functionGlobalContext: { fs: require('fs'), csv: require('csv-parser'), path: require('path'), async: require('async'), yaml: require('js-yaml'), os: require('os') }. Default path summary: Item / Default location / Description. 1. VTR root directory: C:\\VTR — Virtual Tool Room root directory. 2. Default raw-data storage location: C:\\VTR\\RawData\\Source\\Data\\*.txt — stores detected raw TXT data. 3. Default parsed CSV storage location: C:\\VTR\\RawData\\Output\\*.csv — stores parsed CSV data. 4. Default log storage location: C:\\VTR\\Logs\\ — stores error logs and message records."@en ;
    sth:has_file sth:DataProcess_exe,
        sth:InitSTH_py,
        sth:InitSTH_u_json,
        sth:STHComm_exe,
        sth:STHLink_exe,
        sth:STHScan_exe,
        sth:setting_js ;
    sth:has_setting sth:log_file_location,
        sth:output_path,
        sth:raw_data_directory_location,
        sth:root_directory_location ;
    sth:has_subfolder sth:library_folder,
        sth:logs_folder,
        sth:node_red_folder,
        sth:plans_folder,
        sth:raw_data_folder,
        sth:reports_folder,
        sth:simulation_folder ;
    sth:root_directory "c:\\VTR" ;
    sth:setting_js_content "flowFile: 'vtr_flows(YYYYMMDDV).json'; functionGlobalContext includes fs, csv-parser, path, async, js-yaml, and os."@en ;
    sth:vtr_root_directory "C:\\VTR" .

