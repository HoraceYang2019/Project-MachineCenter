sth:power_issue_no_led_after_shaking a sth:abnormal_case ;
    rdfs:label "Power abnormality case 1"@en ;
    sth:abnormal_cause "The tool holder may be in Sleep-Wake Mode or have insufficient power."@en ;
    sth:answer "The tool holder may be in Sleep-Wake Mode or have insufficient power. Connect it to the charging dock, complete charging, and then remove it for use."@en ;
    sth:applicable_question "No LED is displayed after shaking the tool holder."@en ;
    sth:cause "The tool holder may be in Sleep-Wake Mode or have insufficient power."@en ;
    sth:description "If no LED is displayed after shaking the tool holder, the tool holder may be in Sleep-Wake Mode or have insufficient power. Connect it to the charging dock and complete charging, then remove it and shake it again to return it to an operational state."@en ;
    sth:troubleshooting_method "Connect the tool holder to the charging dock. After charging is complete, shake the tool holder to enter Idle Mode."@en .

