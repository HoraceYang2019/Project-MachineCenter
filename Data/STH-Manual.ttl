sth:case_3 a sth:abnormal_case ;
    rdfs:label "No available tool holder is displayed after executing LOAD STHSCAN."@en,
        "Smart Tool Holder cannot be scanned"@en,
        "Tool holder cannot be found after running the scan function."@en ;
    sth:cause "Available tool holder MAC and Port are not displayed."@en ;
    sth:description "After LOAD STHSCAN is executed, available tool holders are not displayed. Normally, the MAC and Port of the tool holder are shown. If none are shown, troubleshoot as follows: A. Confirm the tool holder status and shake it to enter Idle Mode (green LED flashing). B. Check whether the settings under Connection Check are correct, including Networking (TCP/IP settings) and MessageBroking (MQTT settings), as shown in the figure. C. Check the configured IP and Router location; the IP address is 10.0.0.103 and the subnet mask is 255.255.255.0."@en ;
    sth:direct_answer "If no available tool holder is displayed after LOAD STHSCAN, confirm the tool holder status, check the Connection Check settings, and verify that the IP address is 10.0.0.103 and the subnet mask is 255.255.255.0."@en ;
    sth:question "No available tool holder is displayed after executing LOAD STHSCAN."@en ;
    sth:scan_failure_handling_method "First confirm the tool holder status; shake it to enter Idle Mode (green LED flashing). Check Networking (TCP/IP settings) and MessageBroking (MQTT settings) under Connection Check. Check the configured IP and Router location; the IP address is 10.0.0.103 and the subnet mask is 255.255.255.0."@en ;
    sth:troubleshooting_method "Confirm that the tool holder is in Idle Mode; check Networking (TCP/IP) and MessageBroking (MQTT) settings; confirm that the IP is 10.0.0.103 and the subnet mask is 255.255.255.0."@en .

sth:charging_module a sth:section ;
    rdfs:label "Charging module"@en ;
    sth:AdapterOutputCurrent "2A" ;
    sth:AdapterOutputVoltage "DC 12V" ;
