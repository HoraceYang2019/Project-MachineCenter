        sth:maximum_charging_time,
        sth:maximum_input_current,
        sth:operating_temperature,
        sth:storage_temperature ;
    sth:led_mapping "Not charging: Green -, Red -; Charging: Red On; Fully charged: Green On."@en ;
    sth:output_current "2A" ;
    sth:solid_green_led_means "Fully charged"@en ;
    sth:solid_red_led_means "Charging"@en ;
    sth:unlit_led_means "Not charging. If the LED remains off after the tool holder is connected to the charging dock, follow the troubleshooting case to check the charging contacts, adapter, or charging dock."@en ;
    sth:what_does_solid_green_led_on_charging_dock_mean "A solid green LED means fully charged."@en ;
    sth:what_does_solid_red_led_on_charging_dock_mean "A solid red LED means charging."@en .

sth:general_specification a sth:section ;
    rdfs:label "General Specifications"@en ;
    sth:description "General Specifications. Table 2, Smart Tool Holder General Specifications. Item / Smart Tool Holder - Turing-E. Signal characteristics: signal sampling rate up to 3.6 kHz per channel; detection items Fx, Fy, Mz; precision ±3%. Communication architecture: Wi-Fi; frequency band 2.45 GHz 802.11 b/g/n. Power supply: continuous operation >6 hr; standby time >10 day. Mechanical characteristics: water and dust resistance IP67; charging method contact charging; maximum speed G1/15,000 rpm. Software characteristics: force monitoring — online monitoring; tool wear estimation — Option; system integration function — Option."@en ;
