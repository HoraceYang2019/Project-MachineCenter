    rdfs:label "Cutting-force data file"@en ;
    sth:bending_force_line_chart_description "Plotting BendingX as a line chart shows the force variation in the X direction."@en ;
    sth:description "Cutting-force data file. Files in the RawData\\Output\\ folder. Parsed CSV data, such as *.csv: TimeTag — time tag (sec); CH1 — strain-gauge channel 1 signal; CH2 — strain-gauge channel 2 signal; BendingX — X-direction bending force (Nm); BendingY — Y-direction bending force (Nm); Torque — torque (Nm). Plotting CH1 and CH2 as a scatter plot can represent the flute profile of a four-flute cutter. Plotting BendingX as a line chart shows force variation in the X direction."@en ;
    sth:field_description "TimeTag is the time tag (sec); CH1 is the strain-gauge channel 1 signal; CH2 is the strain-gauge channel 2 signal; BendingX is the X-direction bending force (Nm); BendingY is the Y-direction bending force (Nm); Torque is torque (Nm)."@en ;
    sth:flute_profile_chart_description "Plotting CH1 and CH2 as a scatter plot can represent the flute profile of a four-flute cutter."@en ;
    sth:has_field sth:bending_x_field,
        sth:bending_y_field,
        sth:ch1_field,
        sth:ch2_field,
        sth:time_tag_field,
        sth:torque_field .

