        sth:production_plan_settings_quick ;
    sth:how_to_bind_smart_tool_holder_and_tool "On the Plan Settings page, select the Smart Tool Holder MAC under STH and the tool number under TID, then click BIND to bind the Smart Tool Holder and the tool."@en ;
