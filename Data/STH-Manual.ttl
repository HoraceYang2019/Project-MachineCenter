sth:virtual_tool_room a sth:system ;
    rdfs:label "Virtual Tool Room"@en ;
    sth:abbreviation "VTR" ;
    sth:add_control_limits_method "On the History Review page, first select Folder and File, then click ADD UCL LCL. The system adds upper and lower control limits to the selected CSV file, and the output filename is the original filename + _processed."@en ;
    sth:english_name "Virtual Tool Room" .

sth:what_to_do_if_smart_tool_holder_cannot_be_scanned a sth:qa_anchor ;
    rdfs:label "No available tool holder is displayed after executing LOAD STHSCAN."@en,
        "Smart Tool Holder cannot be scanned"@en,
        "What should I do if the Smart Tool Holder cannot be scanned"@en ;
    sth:answer "If no available tool holder is displayed after LOAD STHSCAN, first confirm the tool holder status and shake it to enter Idle Mode (green LED flashing). Then check Networking (TCP/IP settings) and MessageBroking (MQTT settings) under Connection Check. Finally, check the IP and Router location; the IP address is 10.0.0.103 and the subnet mask is 255.255.255.0."@en ;
    sth:corresponding_topic sth:case_3 ;
    sth:handling_method "A. First confirm the tool holder status; shake the tool holder to enter Idle Mode (green LED flashing). B. Check whether Networking (TCP/IP settings) and MessageBroking (MQTT settings) under Connection Check are correct. C. Check the configured IP and Router location. The IP address is 10.0.0.103 and the subnet mask is 255.255.255.0."@en ;
    sth:question "What should I do if the Smart Tool Holder cannot be scanned?"@en ;
    sth:scan_failure_handling_method "First confirm the tool holder status and shake it to enter Idle Mode. Check Networking (TCP/IP settings) and MessageBroking (MQTT settings). Check the IP and Router location; the IP address is 10.0.0.103 and the subnet mask is 255.255.255.0."@en .

