sth:sleep_mode a sth:section ;
    rdfs:label "Sleep Mode"@en ;
    sth:description "Sleep Mode. Shaking beyond the G-threshold switches the device back to Transmission Mode. Sleep-Wake Mode: Table 9, Sleep Settings. Function / Edge Command / WSB Response. 1. Enter Sleep Mode: sleep\\n / Enter Sleep Mode\\n / Leave Sleep-Wake Mode and enter Sleep Mode. 2. Enter Idle Mode: exit\\n / Enter Idle Mode\\n / Leave Sleep-Wake Mode and enter Idle Mode. In Transmission Mode, after Edge receives data from the STH, the received data can be divided into two groups: Header and Content. The Header records information such as MAC and transmission time, while Content records four-channel data."@en ;
    sth:has_command sth:sleep_enter_idle_mode_command,
        sth:sleep_enter_sleep_mode_command ;
    sth:has_mode sth:qa_sleep_wake_mode_answer ;
    sth:method_to_wake_up_smart_tool_holder "Shake the tool holder beyond the G-threshold to switch back to Transmission Mode."@en ;
    sth:sleep_wake_mode_description "After a polling interval is configured, WSB can periodically leave Sleep Mode and enter a brief wake state; in this mode it reports one Header (packet sequence number: 99999) to Edge."@en .

sth:smart_tool_holder_blue_led_status a sth:qa_anchor ;
    rdfs:label "Smart Tool Holder blue LED status"@en,
        "Transmission Mode blue LED status"@en,
        "What does a blue LED on the Smart Tool Holder mean"@en ;
    sth:answer "A blue LED on the Smart Tool Holder means the TCP packet channel is enabled and the Smart Tool Holder is in Transmission Mode or normally connected."@en ;
    sth:blue_led_status "TCP packet channel enabled, indicating that the Smart Tool Holder is in Transmission Mode or normally connected."@en ;
    sth:corresponding_topic sth:data_collection_quick,
        sth:mode_switching ;
    sth:led_color "Blue"@en ;
    sth:question "What does a blue indicator on the Smart Tool Holder mean?"@en,
        "What does it mean when the Smart Tool Holder displays a blue LED?"@en,
        "What does it mean when the Smart Tool Holder displays blue after LOAD ALL?"@en,
        "What status does a blue LED on the Smart Tool Holder indicate?"@en ;
    sth:represented_mode "Transmission Mode"@en ;
    sth:transmission_mode_blue_led_status "TCP packet channel enabled, indicating that the Smart Tool Holder is in Transmission Mode."@en ;
    skos:prefLabel "Smart Tool Holder blue LED status"@en .

sth:smart_tool_holder_component a sth:component ;
    rdfs:label "STH body component"@en ;
    sth:quantity "1"^^xsd:int .

sth:smart_tool_holder_introduction a sth:section ;
    rdfs:label "Smart Tool Holder Introduction"@en ;
    sth:description "Smart Tool Holder Introduction. This chapter introduces the application architecture, general specifications, certification requirements, and charging-module specifications of the Smart Tool Holder (STH). As shown in Figure 4, Smart Tool Holder sensor signals inside a standalone CNC machine can connect through a wireless Router to the machine-side device (Raspberry RPi/OT) using 2.4G Wi-Fi. The machine-side device connects through a wired network and Router to the Edge PC graphical operating software. In addition to synchronizing with the CNC controller through a controller communication interface such as OPC/UA to capture current CNC status, coordinates, NC data, and settings, the Edge PC software uses the MQTT protocol to centrally control and manage machine-side devices on each machine. MQTT is responsible for data communication between the Smart Tool Holder and the Virtual Tool Room (VTR). The machine-side device interfaces with the Smart Tool Holder and parses, converts, stores, processes, and compares its sensor signals. Parsed feature data is automatically stored as the basis for subsequent data analysis and abnormality detection. In application, the machine-side device can publish sensor summaries to the Edge PC through MQTT. The Virtual Tool Room (VTR) provided by the Edge PC can configure machining plans, display current Smart Tool Holder status and machining signals, configure control limits, and perform offline analysis. Figure 4, Smart Tool Holder application architecture."@en ;
    sth:has_subsection sth:charging_module,
        sth:general_specification,
        sth:test_standard .

