sth:smart_tool_holder_wake_up_method a sth:qa_anchor ;
    rdfs:label "How to wake the Smart Tool Holder"@en,
        "Sleep Mode wake-up method"@en,
        "Smart Tool Holder wake-up method"@en ;
    sth:answer "When the Smart Tool Holder is in Sleep Mode, shaking it beyond the G-threshold wakes it. After waking, it first enters Idle Mode and then switches back to Transmission Mode once the connection to Edge or Router is complete; this normally takes about 10 seconds."@en ;
    sth:completion_time "After waking from Sleep Mode, connecting to the Router and entering Transmission Mode normally takes about 10 seconds."@en ;
    sth:corresponding_topic sth:mode_switching,
        sth:smart_tool_holder_advanced_settings ;
    sth:disambiguation "This node answers the general wake-up method. Only when there is no LED at all after shaking does the issue belong to power-abnormality or Sleep-Wake Mode troubleshooting."@en ;
    sth:question "How can I wake the Smart Tool Holder from Sleep Mode?"@en,
        "How can I wake up the Smart Tool Holder?"@en,
        "How do I wake the Smart Tool Holder while it is in Sleep Mode?"@en,
        "What is the procedure for waking up the Smart Tool Holder?"@en ;
    sth:wake_up_condition "Shake beyond the G-threshold."@en ;
    sth:wake_up_method "Shake the Smart Tool Holder beyond the G-threshold to wake it."@en ;
    sth:wake_up_process "After motion exceeding the G-threshold is detected in Sleep Mode, the Smart Tool Holder leaves Sleep Mode, first enters Idle Mode, and switches back to Transmission Mode after the connection is completed."@en ;
    skos:prefLabel "Smart Tool Holder wake-up method"@en .

