    sth:value "Option" .

sth:temperature_impact_analysis a sth:analysis ;
    rdfs:label "Temperature Impact Analysis"@en ;
    sth:conclusion "Stable measurements can be obtained when the internal tool-holder temperature is maintained below 60°C."@en ;
    sth:description "Temperature Impact Analysis. Execution time: 5/5 16:37–5/5 16:40 and 5/5 17:44, 2025. Execution conditions: spindle speed 10000 rpm; feed 180 mm/min; depth/width of cut 0.5/0.1 mm; maximum temperature 60°C; minimum temperature 25°C; duration 2.5 min. Tool conditions: tool diameter 2 mm; tool length 5 mm; 4 flutes. Description: the Smart Tool Holder uses strain gauges to measure deformation during machining. During continuous machining, spindle heating transfers heat to the tool holder and gradually increases its internal temperature. This analysis examines the dependence of Smart Tool Holder sensor signals on temperature changes. Results: the tool holder was first heated to 70°C and continuous machining was performed with the same tool, as in Exp1–Exp3. Cutting torque increased as tool wear increased. Across different experiments, deformation detected by the strain gauges was relatively stable when the internal tool-holder temperature was 60–25°C, but fluctuations were larger above 60°C; temperatures above 60°C may increase the signal. The results show that stable measurements can be obtained when the internal tool-holder temperature is maintained below 60°C."@en ;
    sth:high_temperature_effect "Above 60°C, the signal fluctuates more strongly; temperatures above 60°C may increase the signal level."@en ;
    sth:result "When the internal tool-holder temperature is 60–25°C, deformation detected by the strain gauge is relatively stable; above 60°C, the signal fluctuates more strongly."@en ;
    sth:stable_temperature_condition "Stable measurements can be obtained when the internal tool-holder temperature is kept below 60°C."@en .

sth:test_standard a sth:section ;
    rdfs:label "Test standards (conformity tests)"@en ;
    sth:description "Test standards (conformity tests). Category / Test standard or condition. RF: EN300328, Taiwan LP0002, FCC 15C. EMC: FCC 15B, EN301489-1, EN301489-17; heavy industrial equipment: IEC/EN61000-6-2 (EMS, Immunity), IEC/EN61000-6-4 (EMI, Emission); IEC61000-4-2 (ESD Test). Safety: EN62311 (EMF); Charger: EN 62368; Battery Cell & Pack: IEC/EN 62133-2:2017, UN 38.3; Machinery Directive 2006/42/EC; EN ISO 12100. Function: IEC 60529-IP67 (water and dust resistance). Environment: RoHS."@en ;
    sth:has_test_category sth:emc_test,
        sth:environment_test,
        sth:function_test,
        sth:rf_test,
        sth:safety_test_1,
        sth:safety_test_2 .

