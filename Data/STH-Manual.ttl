sth:smart_tool_holder_operating_modes rdfs:label "Smart Tool Holder operating modes"@en ;
    sth:altLabel "Smart Tool Holder mode list"@en,
        "What are the Smart Tool Holder operating modes"@en,
        "What modes does the Smart Tool Holder have?"@en ;
    sth:answer "The main Smart Tool Holder operating modes are Idle Mode, Transmission Mode, Configuration Mode, Sleep Mode, and Sleep-Wake Mode."@en ;
